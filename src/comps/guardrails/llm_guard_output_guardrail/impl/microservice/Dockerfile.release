FROM out-guard-base:latest

COPY compliance /compliance

WORKDIR /compliance/ospdt
COPY Dockerfile .
COPY uv.lock .

# CMD from base Dockerfile
WORKDIR /home/user/comps/guardrails/llm_guard_output_guardrail/
# Run as the same non-root user as the base image (explicit for image scanners)
USER user

CMD ["python", "erag_llm_guard_output_guardrail_microservice.py"]
